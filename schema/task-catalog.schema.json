{
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "prefixes",
    "prompts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "visibility"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "prefixes": {
      "type": "object",
      "required": [
        "shared",
        "specialists"
      ],
      "additionalProperties": false,
      "properties": {
        "shared": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "specialists": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:P\\d{3}|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "brand",
          "specialist",
          "objective",
          "input_requirements",
          "output_contract",
          "owning_repository",
          "owning_issue",
          "role_owner",
          "dependencies",
          "visibility",
          "acceptance",
          "resource_ceiling",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:P\\d{3}|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "specialist": {
            "type": "string",
            "pattern": "^(?:P\\d{3}|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "input_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "output_contract": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "owning_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "owning_issue": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "role_owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "resource_ceiling": {
            "type": "object",
            "required": [
              "currency",
              "cash_minor",
              "attempts",
              "time_minutes"
            ],
            "additionalProperties": false,
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "cash_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "time_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/frankxai/prompt-engine/schema/task-catalog.schema.json",
  "title": "Local task catalog adapter",
  "description": "Owner-supplied adapter input. Runtime validation also enforces unique IDs and resolved shared/specialist prefixes. Corpus ownership remains in prompt-library."
}

{
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "content_sha256",
    "source",
    "prompt_id",
    "version",
    "title",
    "brand",
    "specialist",
    "objective",
    "input_requirements",
    "output_contract",
    "owning_repository",
    "owning_issue",
    "role_owner",
    "dependencies",
    "visibility",
    "acceptance",
    "resource_ceiling",
    "source_prompt_visibility",
    "instructions",
    "execution",
    "brief_markdown"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^task_[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "visibility"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^(?:P\\d{3}|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "specialist": {
      "type": "string",
      "pattern": "^(?:P\\d{3}|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "input_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "output_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "owning_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "owning_issue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "role_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "resource_ceiling": {
      "type": "object",
      "required": [
        "currency",
        "cash_minor",
        "attempts",
        "time_minutes"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cash_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "time_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "source_prompt_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "instructions": {
      "type": "object",
      "required": [
        "shared",
        "specialist",
        "task"
      ],
      "additionalProperties": false,
      "properties": {
        "shared": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "specialist": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "state",
        "execution_id",
        "receipt"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "prepared",
            "queued",
            "running",
            "completed",
            "blocked",
            "cancelled",
            "failed"
          ]
        },
        "execution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "state",
                "execution_id",
                "adapter",
                "received_at"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "enum": [
                    "queued",
                    "running",
                    "completed",
                    "blocked",
                    "cancelled",
                    "failed"
                  ]
                },
                "execution_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "adapter": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "received_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "completed"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "evidence_ref"
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "prepared"
              }
            }
          },
          "then": {
            "properties": {
              "execution_id": {
                "type": "null"
              },
              "receipt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "receipt": {
                "type": "object",
                "required": [
                  "state",
                  "execution_id",
                  "adapter",
                  "received_at"
                ],
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "enum": [
                      "queued",
                      "running",
                      "completed",
                      "blocked",
                      "cancelled",
                      "failed"
                    ]
                  },
                  "execution_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "adapter": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "received_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "state": {
                          "const": "completed"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "evidence_ref"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "brief_markdown": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/frankxai/prompt-engine/schema/task-packet.schema.json",
  "title": "Composed task packet",
  "description": "Complete local task brief. Runtime checks enforce the composition hash, Markdown parity, visibility inheritance, receipt consistency and allowed state transitions."
}
